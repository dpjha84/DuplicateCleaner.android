<resources>
    <style name="Theme.DuplicateCleaner" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: indigo background with the app mark, then hands over to the app theme. -->
    <style name="Theme.DuplicateCleaner.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4F46E5</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.DuplicateCleaner</item>
    </style>
</resources>
